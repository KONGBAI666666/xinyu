# ============================================================
# Docker 部署环境变量模板: 复制为 .env 并填入真实值 (.env 已在 .gitignore)
# ============================================================

# mysql 容器 root 密码 (同时注入后端数据源)
MYSQL_PASSWORD=

# JWT 签名密钥: HS256 要求至少 32 个字符的随机字符串
# 注意: 该密钥同时充当用户 LLM API Key 的 AES 加密密钥, 请勿与其他系统复用
XINYU_JWT_SECRET=

# Java <-> Python AI 服务内部接口令牌 (保护 DELETE /ai/rag/vectors 等破坏性操作)
# 两端共用同一值; 留空则不校验 (仅限可信内网)
XINYU_AI_INTERNAL_TOKEN=
