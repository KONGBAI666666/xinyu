# ============================================================
# Docker 部署环境变量模板: 复制为 .env 并填入真实值 (.env 已在 .gitignore)
# ============================================================

# mysql 容器 root 密码 (同时注入后端数据源)
MYSQL_PASSWORD=

# JWT 签名密钥: HS256 要求至少 32 个字符的随机字符串
XINYU_JWT_SECRET=

# (可选) 用户 LLM API Key 的 AES 加密密钥: 与 JWT 密钥解耦, 便于独立轮换
# 留空 = 回退使用 XINYU_JWT_SECRET (兼容已有部署);
# 注意: 数据库中已有加密 API Key 时, 变更此值会导致旧密文无法解密
XINYU_CRYPTO_SECRET=

# (可选) Embedding 模型覆盖: 默认按用户默认模型的服务商自动映射
# (通义→text-embedding-v2/1536, OpenAI→text-embedding-3-small/1536, 智谱→embedding-3/2048)。
# 使用 Ollama 或无法识别的服务商时必须显式配置, 例如:
#   XINYU_EMBEDDING_MODEL=bge-m3
#   XINYU_EMBEDDING_DIM=1024
XINYU_EMBEDDING_MODEL=
XINYU_EMBEDDING_DIM=
