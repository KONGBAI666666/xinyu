# ============================================================
# Docker 部署环境变量模板: 复制为 .env 并填入真实值 (.env 已在 .gitignore)
# ============================================================

# mysql 容器 root 密码 (仅用于容器初始化/迁移脚本, 不进应用链路)
MYSQL_PASSWORD=

# 应用专用数据库账号 (最小权限: 仅 xinyu 库; 镜像自动创建, 本地开发需手动建)
# 创建语句见 docs-private/学习路线-大三到秋招.md 或:
#   CREATE USER 'xinyu_app'@'%' IDENTIFIED BY '<强密码>';
#   GRANT ALL PRIVILEGES ON `xinyu`.* TO 'xinyu_app'@'%';
XINYU_DB_USER=xinyu_app
XINYU_DB_PASSWORD=

# JWT 签名密钥: HS256 要求至少 32 个字符的随机字符串
XINYU_JWT_SECRET=

# (可选) 用户 LLM API Key 的 AES 加密密钥: 与 JWT 密钥解耦, 便于独立轮换
# 留空 = 回退使用 XINYU_JWT_SECRET (兼容已有部署);
# 注意: 数据库中已有加密 API Key 时, 变更此值会导致旧密文无法解密
XINYU_CRYPTO_SECRET=

# (可选) Embedding 模型覆盖: 默认按用户默认模型的服务商自动映射
# (通义→text-embedding-v2/1536, OpenAI→text-embedding-3-small/1536, 智谱→embedding-3/2048)。
# 使用 Ollama 或无法识别的服务商时必须显式配置, 例如:
#   XINYU_EMBEDDING_MODEL=bge-m3
#   XINYU_EMBEDDING_DIM=1024
XINYU_EMBEDDING_MODEL=
XINYU_EMBEDDING_DIM=

# (可选) 出站防护例外: 默认拒绝用户模型的 baseUrl 指向内网/环回地址 (防 SSRF)。
# 仅在隔离网络内自建模型服务 (如容器内 Ollama) 需要放开时设为 1
XINYU_LLM_ALLOW_PRIVATE_BASEURL=

# (可选) 管理员引导: 启动时把该用户名提升为 ADMIN (幂等), 留空不提升。
# 用于开启管理后台 (/admin), 免手工改库
XINYU_ADMIN_USERNAME=
