# ============================================================
# Docker 部署环境变量模板: 复制为 .env 并填入真实值 (.env 已在 .gitignore)
# ============================================================

# mysql 容器 root 密码 (同时注入后端数据源)
MYSQL_PASSWORD=

# JWT 签名密钥: HS256 要求至少 32 个字符的随机字符串
XINYU_JWT_SECRET=

# 通义千问 API Key (仅用于 stats 模块的定价配置; LLM 调用走 Python AI 服务, Key 已存数据库)
# 可留空, 不影响核心功能
DASHSCOPE_API_KEY=
